# meta-bot-ship PR review bot — env (copy to ~/.pr-review-bot.env on the mini, chmod 600)

# Repos to watch (comma-separated owner/repo)
PR_BOT_REPOS=metaDAOproject/backend

# Bot GitHub login (matches the active gh account on the mini)
PR_BOT_USER=meta-bot-ship

# Review engine: codex (default, uses `codex review`) or llm (direct API)
PR_BOT_ENGINE=codex
PR_BOT_CODEX_EFFORT=xhigh

# --- llm engine only (unused when PR_BOT_ENGINE=codex) ---
# PR_BOT_PROVIDER=openrouter
# PR_BOT_MODEL=google/gemini-2.5-pro
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
