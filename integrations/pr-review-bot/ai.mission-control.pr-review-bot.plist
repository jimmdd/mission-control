<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.mission-control.pr-review-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bot/pr-review-bot/run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/bot/pr-review-bot</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>StandardOutPath</key>
    <string>/Users/bot/pr-review-bot/logs/pr-review-bot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bot/pr-review-bot/logs/pr-review-bot.log</string>
</dict>
</plist>
