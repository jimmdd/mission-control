{
  "name": "mission-control",
  "version": "1.0.0",
  "description": "Standalone mission control service for autonomous AI agent swarms",
  "type": "module",
  "main": "server.ts",
  "bin": {
    "mc": "./mc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmdd/mission-control.git"
  },
  "author": "jimmdd",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mission-control",
    "task-management",
    "agent-tools",
    "agent-swarm",
    "context-fabrica"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "start": "npx tsx server.ts",
    "mc": "tsx src/cli.ts"
  },
  "dependencies": {
    "@opengsd/gsd-core": "^1.11.0",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.8",
    "typescript": "^5.7.2"
  }
}
