# Mission Control configuration.
# Copy to ~/.mission-control/.env and fill in what you need.
# Everything here is OPTIONAL — core (tasks, board, checkpoints, objectives)
# works with none of it set. `scripts/setup.sh` copies this file into place.

# --- Server ---
MISSION_CONTROL_URL=http://127.0.0.1:18900
# Only needed if you expose the server beyond localhost — then set a shared token
# and pass it as `Authorization: Bearer ...` or `?token=...`:
# MISSION_CONTROL_ACCESS_TOKEN=use-a-long-random-value

# --- Text generation (triage / planner / autopilot): set ONE provider ---
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# ...or point the planner at a local Ollama model instead (see README).

# --- Knowledge memory (optional: Postgres + pgvector + context-fabrica) ---
# CONTEXT_FABRICA_DSN=postgresql://USER@localhost/context_fabrica
# CONTEXT_FABRICA_SCHEMA=mission_control
# EMBEDDING_PROVIDER=fastembed
# CONTEXT_FABRICA_EMBEDDING_DIMENSIONS=384

# --- Integrations (optional) ---
# LINEAR_API_KEY=
# LINEAR_WORKSPACE=Your Workspace Name

# --- Agent git identity (optional) ---
# Give the swarm agents a SEPARATE git/GitHub identity (a bot) so their commits and
# PRs aren't attributed to your local user. These are injected ONLY into agent
# sessions — your own shell, global git config, and `gh` login are untouched.
# The bot account needs push access (collaborator) on the target repos; the token
# needs `repo` scope.
# MC_AGENT_GIT_NAME=MetaDAO Bot
# MC_AGENT_GIT_EMAIL=bot@metadao.fi
# MC_AGENT_GH_TOKEN=ghp_your_bot_personal_access_token

# --- GSD planning/verification backend ---
MISSION_CONTROL_GSD_BACKEND=core
